#!/usr/bin/env bash
# Re-push FONT= from /etc/vconsole.conf onto the live console.
#
# Why this exists: after GPU passthrough returns the card, fbcon often resets
# to a tiny default *before* SDDM/Hypr. systemd-vconsole-setup frequently
# refuses ("All allocated virtual consoles are busy"). Direct setfont still
# works — Style → TTY Fonts already does that. This helper is the same poke,
# for udev (DRM card add) and manual `omatty reapply`.
#
# Default: setfont on the *active* VT only. A chvt sweep through tty1–6 makes
# every getty fat, but it races SDDM (usually tty1) and breaks the greeter —
# exactly the host path vm-curator / single-GPU passthrough expects after the
# VM releases the card. Do not chvt from udev.
#
# Opt-in: OMATTY_REAPPLY_ALL=1 or --all-vts for a manual chvt pass when SDDM
# is stopped (nested VM tests, cold console-only sessions).
#
# Safe as root (udev) or via sudo. No-op when FONT= is unset.
set -euo pipefail

conf="${OMATTY_VCONSOLE:-/etc/vconsole.conf}"
fonts_dir="${OMATTY_CONSOLEFONTS:-/usr/share/kbd/consolefonts}"
vt_max="${OMATTY_VT_MAX:-6}"
quiet=0
all_vts=0
[[ ${OMATTY_REAPPLY_ALL:-0} == 1 ]] && all_vts=1
for arg in "$@"; do
  case $arg in
    --quiet|-q) quiet=1 ;;
    --all-vts|--all) all_vts=1 ;;
  esac
done

note() { (( quiet )) || printf 'omatty-reapply: %s\n' "$1" >&2; }

[[ -f $conf ]] || exit 0

font=
while IFS= read -r line || [[ -n $line ]]; do
  case $line in
    FONT=*)
      font=${line#FONT=}
      font=${font#\"}
      font=${font%\"}
      font=${font#\'}
      font=${font%\'}
      break
      ;;
  esac
done <"$conf"

[[ -n $font ]] || exit 0

resolve() {
  local stem=$1
  local candidate
  if [[ -f $stem ]]; then
    printf '%s\n' "$stem"
    return 0
  fi
  for candidate in \
    "$fonts_dir/${stem}.psfu.gz" \
    "$fonts_dir/${stem}.psf.gz" \
    "$fonts_dir/${stem}.psfu" \
    "$fonts_dir/${stem}.psf" \
    "$fonts_dir/$stem"
  do
    if [[ -f $candidate ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf '%s\n' "$stem"
}

target=$(resolve "$font")

push_active() {
  local i
  for i in 1 2 3 4 5 6 7 8; do
    if setfont "$target" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.35
  done
  return 1
}

# Best-effort on numbered VTs without chvt (often fails on inactive fbcon).
push_console() {
  local console=$1
  setfont "$target" -C "$console" >/dev/null 2>&1
}

# --- opt-in only: visit each getty (SDDM must not be running) ---------------
if (( all_vts )); then
  if [[ -d /run/sddm || -d /run/lightdm || -d /run/gdm ]] \
      || compgen -G "/run/user/*/wayland-*" >/dev/null 2>&1; then
    note "refusing --all-vts while a greeter/graphical session is up (would steal the login VT)"
    all_vts=0
  fi
fi

if (( all_vts )); then
  cur=
  if [[ -r /sys/class/tty/tty0/active ]]; then
    cur=$(cat /sys/class/tty/tty0/active 2>/dev/null || true)
    cur=${cur#tty}
  fi
  [[ -n $cur ]] || cur=$(fgconsole 2>/dev/null || echo 1)

  sleep 0.4
  hit=0
  n=1
  while (( n <= vt_max )); do
    if [[ -c /dev/tty$n ]] && chvt "$n" 2>/dev/null; then
      sleep 0.15
      if setfont "$target" >/dev/null 2>&1; then
        hit=$((hit + 1))
      fi
    fi
    n=$((n + 1))
  done
  chvt "$cur" 2>/dev/null || true

  if (( hit > 0 )); then
    note "setfont $font on $hit VTs (--all-vts, back on tty$cur)"
    exit 0
  fi
fi

# --- default / udev: active VT only (+ quiet -C attempts, no chvt) ----------
ok=0
if push_active; then
  ok=1
fi

n=1
extra=0
while (( n <= vt_max )); do
  if [[ -c /dev/tty$n ]] && push_console "/dev/tty$n"; then
    extra=$((extra + 1))
    ok=1
  fi
  n=$((n + 1))
done

if (( ok )); then
  note "setfont $font (active + $extra ttyN via -C; no chvt)"
  exit 0
fi
note "setfont failed for $font (fbcon not ready?)"
exit 1
